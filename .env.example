# API requests go directly to this backend host in development and production.
# Override in .env.local if needed; omit /api/v1.
VITE_API_HOST=https://warranty-evidence.omnisuiteai.com
# An HTTPS PWA requires an HTTPS backend that allows the PWA origin in CORS.
# VITE_BASE_PATH=/
# Web push: register a WEB app in the existing Firebase project and supply
# its public configuration and Cloud Messaging web push certificate (VAPID key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Optional authenticated topic bridge: npm run serve (Node 22+).
# Set server credentials only on the server; NEVER prefix these with VITE_.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# VITE_PUSH_BRIDGE_URL=/pwa-api/push/topics
