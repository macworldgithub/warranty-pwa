# Replace the domain, certificate paths and root with your deployment values.
server {
    listen 443 ssl;
    server_name warranty.example.com;
    ssl_certificate /etc/letsencrypt/live/warranty.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/warranty.example.com/privkey.pem;
    root /var/www/booran-warranty/dist;
    index index.html;
    client_max_body_size 100m;

    location /api/ {
        proxy_pass https://warranty-evidence.omnisuiteai.com;
        proxy_ssl_server_name on;
        proxy_set_header Host warranty-evidence.omnisuiteai.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
    location /uploads/ {
        proxy_pass https://warranty-evidence.omnisuiteai.com;
        proxy_ssl_server_name on;
        proxy_set_header Host warranty-evidence.omnisuiteai.com;
    }
    # Optional: npm run serve provides the authenticated Firebase topic bridge.
    location /pwa-api/ { proxy_pass http://127.0.0.1:4173; }
    location = /sw.js { add_header Cache-Control "no-cache, no-store, must-revalidate"; }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
    location / { try_files $uri $uri/ /index.html; }
}
